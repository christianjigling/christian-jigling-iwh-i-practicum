doctype html
html
    head
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 Custom Object Table
        
        // Här är din nya länk
        a(href="/update-cobj") Add to this table
        
        table
            thead
                tr
                    th Name
                    th Breed
                    th Age
            tbody
                each cat in data
                    tr
                        td #{cat.properties.name}
                        td #{cat.properties.breed}
                        td #{cat.properties.age}